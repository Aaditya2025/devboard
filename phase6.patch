+            </mat-menu>
+          </div>
+
+          <div class="issue-detail__field">
+            <span class="issue-detail__field-label">Reporter</span>
+            <span class="issue-detail__field-value">{{ reporterName() }}</span>
+          </div>
+
+          <div class="issue-detail__field">
+            <span class="issue-detail__field-label">Created</span>
+            <span class="issue-detail__field-value">{{ issue.createdDate }}</span>
+          </div>
+
+          <div class="issue-detail__field">
+            <span class="issue-detail__field-label">Updated</span>
+            <span class="issue-detail__field-value">{{ issue.updatedDate }}</span>
+          </div>
+
+          <div class="issue-detail__field">
+            <span class="issue-detail__field-label">Due Date</span>
+            <span class="issue-detail__field-value">{{ issue.dueDate ?? 'None' }}</span>
+          </div>
