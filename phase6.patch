+            <mat-menu #assigneeMenu="matMenu">
+              <button mat-menu-item type="button" (click)="assignTo(null)">Unassigned</button>
+              @for (user of users(); track user.id) {
+                <button mat-menu-item type="button" (click)="assignTo(user.id)">
+                  {{ user.firstName }} {{ user.lastName }}
+                </button>
