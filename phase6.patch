+              @for (status of statusOptions; track status) {
+                <button mat-menu-item type="button" (click)="changeStatus(status)">{{ status }}</button>
+              }
+            </mat-menu>
+          </div>
+
+          <div class="issue-detail__field">
+            <span class="issue-detail__field-label">Priority</span>
+            <button mat-stroked-button type="button" [matMenuTriggerFor]="priorityMenu" class="issue-detail__field-trigger">
+              <app-priority-badge [priority]="issue.priority" />
+              <mat-icon>arrow_drop_down</mat-icon>
+            </button>
+            <mat-menu #priorityMenu="matMenu">
+              @for (priority of priorityOptions; track priority) {
+                <button mat-menu-item type="button" (click)="changePriority(priority)">{{ priority }}</button>
+              }
+            </mat-menu>
+          </div>
+
+          <div class="issue-detail__field">
