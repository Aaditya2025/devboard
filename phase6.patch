+          <button mat-icon-button type="button" (click)="deleteIssue()" aria-label="Delete issue">
+            <mat-icon>delete</mat-icon>
+          </button>
+        </div>
+      </div>
+
+      <div class="issue-detail__layout">
+        <div class="issue-detail__main">
+          <section class="issue-detail__section">
+            <h2 class="issue-detail__section-title">Description</h2>
+            <p class="issue-detail__description">{{ issue.description || 'No description provided.' }}</p>
+          </section>
+
+          <section class="issue-detail__section">
+            <app-comments [issueId]="issue.id" />
+          </section>
+
+          <section class="issue-detail__section">
+            <h2 class="issue-detail__section-title">Activity</h2>
+            @if (issueActivity().length === 0) {
+              <p class="issue-detail__empty-activity">No activity recorded for this issue yet.</p>
+            } @else {
+              <app-activity-timeline [activities]="issueActivity()" />
+            }
+          </section>
+        </div>
+
+        <aside class="issue-detail__sidebar">
+          <div class="issue-detail__field">
+            <span class="issue-detail__field-label">Status</span>
+            <button mat-stroked-button type="button" [matMenuTriggerFor]="statusMenu" class="issue-detail__field-trigger">
+              <app-status-badge [status]="issue.status" />
+              <mat-icon>arrow_drop_down</mat-icon>
