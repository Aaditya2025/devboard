+  <div class="issue-table" role="table">
+    <div class="issue-table__row issue-table__row--header" role="row">
+      <span>Key</span>
+      <span>Title</span>
+      <button class="issue-table__sort" type="button" (click)="onSort('status')">
+        Status
+        @if (filters().sortBy === 'status') {
+          <mat-icon>{{ filters().sortDirection === 'asc' ? 'arrow_upward' : 'arrow_downward' }}</mat-icon>
+        }
+      </button>
+      <button class="issue-table__sort" type="button" (click)="onSort('priority')">
+        Priority
+        @if (filters().sortBy === 'priority') {
+          <mat-icon>{{ filters().sortDirection === 'asc' ? 'arrow_upward' : 'arrow_downward' }}</mat-icon>
+        }
+      </button>
+      <span>Assignee</span>
+      <button class="issue-table__sort" type="button" (click)="onSort('createdDate')">
+        Created
+        @if (filters().sortBy === 'createdDate') {
+          <mat-icon>{{ filters().sortDirection === 'asc' ? 'arrow_upward' : 'arrow_downward' }}</mat-icon>
+        }
+      </button>
+      <button class="issue-table__sort" type="button" (click)="onSort('dueDate')">
+        Due
+        @if (filters().sortBy === 'dueDate') {
+          <mat-icon>{{ filters().sortDirection === 'asc' ? 'arrow_upward' : 'arrow_downward' }}</mat-icon>
+        }
+      </button>
+    </div>
+
+    @for (issue of issues(); track issue.id) {
+      <a class="issue-table__row" role="row" [routerLink]="['/issues', issue.id]">
+        <span class="issue-table__key">{{ issue.key }}</span>
+        <span class="issue-table__title">{{ issue.title }}</span>
+        <app-status-badge [status]="issue.status" />
+        <app-priority-badge [priority]="issue.priority" />
+        <span class="issue-table__assignee">{{ assigneeName(issue) }}</span>
+        <span class="issue-table__date">{{ issue.createdDate }}</span>
+        <span class="issue-table__date">{{ issue.dueDate ?? '—' }}</span>
+      </a>
+    }
+  </div>
+
+  <app-pagination
+    [page]="filters().page ?? 1"
+    [totalPages]="totalPages()"
+    [totalItems]="totalItems()"
+    [pageSize]="filters().pageSize ?? 10"
+    (pageChange)="onPageChange($event)"
+  />
+}
