+}
+
+.kanban-column__label {
+  font-size: 0.8rem;
+  font-weight: 600;
+  color: var(--db-color-text-primary);
+  text-transform: uppercase;
+  letter-spacing: 0.03em;
+}
+
+.kanban-column__count {
+  margin-left: auto;
+  font-size: 0.75rem;
+  color: var(--db-color-text-secondary);
+  background: var(--db-color-surface);
+  border-radius: 999px;
+  padding: 1px 8px;
+}
+
+.kanban-column__list {
+  flex: 1;
+  overflow-y: auto;
+  padding: 0 var(--db-space-sm) var(--db-space-sm);
+  display: flex;
+  flex-direction: column;
+  gap: var(--db-space-sm);
+  min-height: 60px;
+}
+
+.kanban-column__empty {
+  margin: var(--db-space-sm) 0 0;
+  text-align: center;
+  font-size: 0.78rem;
+  color: var(--db-color-text-disabled);
+}
+
+.kanban-card {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  background: var(--db-color-surface);
+  border: 1px solid var(--db-color-border);
+  border-radius: var(--db-radius-sm);
+  padding: var(--db-space-sm);
+  text-decoration: none;
+  color: inherit;
+  cursor: grab;
+  box-shadow: var(--db-shadow-sm);
+
+  &:hover {
+    box-shadow: var(--db-shadow-md);
+  }
+
+  &.cdk-drag-preview {
+    box-shadow: var(--db-shadow-md);
+  }
+
+  &.cdk-drag-placeholder {
+    opacity: 0.3;
+  }
+}
+
+.kanban-card__drag-preview {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  background: var(--db-color-surface);
+  border: 1px solid var(--db-color-border);
+  border-radius: var(--db-radius-sm);
+  padding: var(--db-space-sm);
+  box-shadow: var(--db-shadow-md);
+  width: 260px;
+}
+
+.kanban-card__key {
+  font-size: 0.72rem;
+  font-weight: 700;
+  color: var(--db-color-text-secondary);
+}
+
+.kanban-card__title {
+  margin: 0;
+  font-size: 0.82rem;
+  color: var(--db-color-text-primary);
+  line-height: 1.3;
+}
+
+.kanban-card__footer {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-top: 2px;
+}
+
+.kanban-card__assignee {
+  font-size: 0.72rem;
+  color: var(--db-color-text-secondary);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  max-width: 110px;
+}
+
+.cdk-drag-animating {
+  transition: transform 200ms cubic-bezier(0, 0, 0.2, 1);
+}
+
+.kanban-column__list.cdk-drop-list-dragging .kanban-card:not(.cdk-drag-placeholder) {
+  transition: transform 200ms cubic-bezier(0, 0, 0.2, 1);
+}
