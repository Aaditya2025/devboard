+    flex: 1 1 240px;
+    min-width: 200px;
+  }
+}
+
+.kanban__filter-field {
+  width: 160px;
+}
+
+.kanban-board {
+  display: flex;
+  gap: var(--db-space-md);
+  overflow-x: auto;
+  padding-bottom: var(--db-space-sm);
+  align-items: flex-start;
+}
+
+.kanban-column {
+  flex: 0 0 280px;
+  width: 280px;
+  display: flex;
+  flex-direction: column;
+  background: var(--db-color-surface-alt);
