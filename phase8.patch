+  font-size: 0.82rem;
+  color: var(--db-color-text-secondary);
+}
+
+.notification-item__time {
+  font-size: 0.72rem;
+  color: var(--db-color-text-secondary);
+}
+
+.notification-item__clear {
+  flex-shrink: 0;
+}
