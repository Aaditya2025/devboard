+              <span>Edit</span>
+            </a>
+            <button mat-menu-item type="button" (click)="archive(project, $event)">
+              <mat-icon>archive</mat-icon>
+              <span>Archive</span>
+            </button>
+          </mat-menu>
+        </div>
+      </a>
+    }
+  </div>
