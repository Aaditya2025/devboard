+<app-page-header title="Projects" subtitle="All projects across your organization.">
+  <button mat-flat-button color="primary" type="button" routerLink="/projects/new">
+    <mat-icon>add</mat-icon>
+    New Project
+  </button>
+</app-page-header>
+
+@if (loading()) {
+  <app-loading-spinner message="Loading projects..." />
+} @else if (error()) {
+  <app-error-state title="Something went wrong." [message]="error() ?? ''" (retry)="retry()" />
+} @else if (projects().length === 0) {
+  <app-empty-state
+    icon="folder_open"
+    message="No projects found."
+    actionLabel="Create Project"
